# Build-context exclusions for the percepta image (spec §12 / M5).
#
# Docker only reads a `.dockerignore` that sits at the context root, so when building
# with the repository root as context (`docker build -f docker/Dockerfile .`) these
# patterns must exist in the repository-root `.dockerignore` too. This file is the
# authoritative list for the image and mirrors the essentials of `.gitignore`; keep the
# two in sync.
#
# Never ignore files the Dockerfile copies: pyproject.toml, README.md, src/, configs/.

# Python bytecode / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtualenvs and tooling caches
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# VCS / CI metadata
.git/
.github/
.gitignore
.dockerignore

# Tests, specs and dev-only trees are not part of the runtime image
tests/
docs/
examples/
percepta-SPEC.md
AGENTS.md
systemd/
docker/

# Model weights must never enter the build context (spec §12)
*.pt
*.pth
*.safetensors
*.ckpt
*.onnx
models/
weights/

# Local artifacts
*.log
.DS_Store
/tmp/
