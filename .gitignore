# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtualenvs / tooling caches
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Model weights must never be committed (spec §12)
*.pt
*.pth
*.safetensors
*.ckpt
models/
weights/
checkpoints/

# Local artifacts
*.log
.DS_Store
/tmp/

# Per-model isolated virtualenvs (docs/model-isolation.md, D33).
# The environment *definitions* under uv_envs/<model>/{pyproject.toml,uv.lock} ARE committed:
# they are what makes a model runtime reproducible. Only the generated venv is ignored.
# Named `uv_envs` rather than `envs` because "envs" reads as simulator environments here.
uv_envs/*/.venv/
.venvs/
